/* QEMU virt マシン向けの物理メモリ配置。kernel.ld から INCLUDE される。
 *
 * 定義すべきシンボル（他のプラットフォームを足すときも同じものを揃えること）:
 *   RAM_END       物理メモリ（DRAM）の終端
 *   FREE_RAM_END  カーネルがページ割り当てに使ってよい領域の終端
 */

/* QEMU virt の既定メモリは 128MB（0x80000000 から） */
RAM_END = 0x88000000;

/* 空き RAM の終端。カーネルはこの範囲全体を起動時にマップするため、
   広げるほど最初のプロセス生成が遅くなる。64MB 程度に留めている */
FREE_RAM_END = 0x84200000;
